# Replace this with a private key for clients of this API (at least 16 characters).
API_KEY=replace-with-a-long-private-api-key

# Get this key from the CoinMarketCap API dashboard. Keep it private.
CMC_API_KEY=replace-with-your-coinmarketcap-api-key

PORT=3000
DATABASE_PATH=./data/prices.sqlite
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_TIMEOUT_MS=5000
SYNC_INTERVAL_MS=60000
LOG_LEVEL=info

# Optional read-only key. It must be at least 16 characters and differ from API_KEY.
# READ_API_KEY=replace-with-a-different-read-only-key
